local CONFIG_FILE = "tower_runner_sky_config.txt"

local function serializeValue(v)
    local t = typeof(v)
    if t == "boolean" then return "b:" .. tostring(v) end
    if t == "number" then return "n:" .. tostring(v) end
    if t == "string" then return "s:" .. tostring(v) end
    if t == "Vector3" then return string.format("v:%g,%g,%g", v.X, v.Y, v.Z) end
    return nil
end

local function deserializeValue(s)
    local prefix = s:sub(1, 2)
    local body = s:sub(3)
    if prefix == "b:" then return body == "true" end
    if prefix == "n:" then return tonumber(body) end
    if prefix == "s:" then return body end
    if prefix == "v:" then
        local x, y, z = body:match("([^,]+),([^,]+),([^,]+)")
        if x and y and z then return Vector3.new(tonumber(x), tonumber(y), tonumber(z)) end
    end
    return nil
end

local function saveConfigFile()
    if not writefile then return false end
    local lines = {}
    for key, value in pairs(config) do
        if type(value) == "table" then
            if key == "CirclePath" then
                table.insert(lines, key .. "=t:" .. table.concat(value, "|"))
            end
        else
            local s = serializeValue(value)
            if s then table.insert(lines, key .. "=" .. s) end
        end
    end
    return pcall(writefile, CONFIG_FILE, table.concat(lines, "\n"))
end

local function loadConfigFile()
    if not (isfile and readfile) then return false end
    local existsOk, exists = pcall(isfile, CONFIG_FILE)
    if not existsOk or not exists then return false end
    local readOk, content = pcall(readfile, CONFIG_FILE)
    if not readOk or not content then return false end
    local count = 0
    for line in content:gmatch("[^\n]+") do
        local key, value = line:match("^([^=]+)=(.+)$")
        if key and value and config[key] ~= nil then
            if value:sub(1, 2) == "t:" then
                local list = {}
                for piece in value:sub(3):gmatch("[^|]+") do table.insert(list, piece) end
                config[key] = list
                count = count + 1
            else
                local v = deserializeValue(value)
                if v ~= nil then config[key] = v; count = count + 1 end
            end
        end
    end
    return count > 0
end

