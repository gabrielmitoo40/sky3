local function handleShardCollector()
    if not config.AutoShardCollector then return end
    if tick() - state.lastShardCollect < config.ShardCollectCooldown then return end
    state.lastShardCollect = tick()

    local drops = workspace:FindFirstChild(config.ShardDropFolderName)
    if not drops then return end

    local root = getRoot()
    if not root then return end

    local keyword = config.ShardDropKeyword:lower()
    for _, drop in ipairs(drops:GetChildren()) do
        if keyword == "" or string.find(drop.Name:lower(), keyword, 1, true) then
            local pos = nil
            if drop:IsA("BasePart") then
                pos = drop.Position
            elseif drop:IsA("Model") then
                local p = drop.PrimaryPart or drop:FindFirstChildWhichIsA("BasePart", true)
                if p then pos = p.Position end
            elseif drop:IsA("Attachment") and drop.Parent and drop.Parent:IsA("BasePart") then
                pos = drop.Parent.Position
            end
            if not pos then continue end

            if drop:IsA("BasePart") then
                pcall(function() drop.CFrame = CFrame.new(root.Position) end)
            elseif drop:IsA("Model") then
                pcall(function()
                    for _, d in ipairs(drop:GetDescendants()) do
                        if d:IsA("BasePart") then pcall(function() d.Anchored = true end) end
                    end
                    drop:PivotTo(CFrame.new(root.Position))
                end)
            end
        end
    end
end

