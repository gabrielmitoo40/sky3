local function handleMobPlatform()
    if not config.AutoMobPlatform then
        safeDestroy(state.autoPlatform)
        state.autoPlatform = nil
        return
    end
    if not isOurClimbRun() then return end
    local cr = workspace:FindFirstChild("ClimbRuns")
    if not cr then return end
    if tick() - state.lastMobPlatformTeleport < config.MobPlatformInterval then return end

    local root = getRoot()
    if not root then return end

    local living = {}
    for _, d in ipairs(cr:GetDescendants()) do
        if d.Name == "Mobs" and #d:GetChildren() > 0 then
            for _, mob in ipairs(d:GetChildren()) do
                trackMobDeath(mob)
                if not isMobDead(mob) then
                    local hrp = mob:FindFirstChild("HumanoidRootPart")
                    local hum = mob:FindFirstChildOfClass("Humanoid")
                    if hrp and hum and hum.Health > 0 then
                        if isMobYours(hrp, root) then
                            table.insert(living, hrp)
                        end
                    end
                end
            end
        end
    end

    if #living > 0 then
        local targetHrp = living[math.random(1, #living)]
        if not state.autoPlatform or not state.autoPlatform.Parent then
            state.autoPlatform = Instance.new("Part")
            state.autoPlatform.Name = "AutoPlatform"
            state.autoPlatform.Size = Vector3.new(20, 1, 20)
            state.autoPlatform.Anchored = true
            state.autoPlatform.CanCollide = true
            state.autoPlatform.Transparency = 0.5
            state.autoPlatform.Parent = workspace
        end
        local platformPos = targetHrp.Position + Vector3.new(0, config.PlatformHeight, 0)
        state.autoPlatform.Position = platformPos

        if config.MobPlatformBurstFire and config.AutoSwing and not state.autoWeaponPaused then
            fireWeaponOnce()
        end

        teleportTo(platformPos, Vector3.new(0, 5, 0))
        state.lastMobPlatformTeleport = tick()
    else
        safeDestroy(state.autoPlatform)
        state.autoPlatform = nil
    end
end

