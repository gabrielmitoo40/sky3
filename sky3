    local function applySearch(query)
        local searchText = string.lower(query or "")
        local activePage = pages[currentTab]
        if not activePage then return end
        for _, child in ipairs(activePage:GetChildren()) do
            if child:IsA("GuiObject") then
                local tag = string.lower(tostring(child:GetAttribute("SearchLabel") or ""))
                child.Visible = (searchText == "" or string.find(tag, searchText, 1, true) ~= nil)
            end
        end
    end

