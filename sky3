local deadMobs = {}

local function trackMobDeath(mob)
    if not mob or deadMobs[mob] then return end
    local hum = mob:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum.Died:Connect(function()
        deadMobs[mob] = true
    end)
    if hum.Health <= 0 then
        deadMobs[mob] = true
    end
end

local function isMobDead(mob)
    return deadMobs[mob] == true
end

