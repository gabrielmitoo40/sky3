local function belongsToOtherPlayer(inst)
    if not inst then return false end
    local attrNames = {
        "Owner", "Player", "UserId", "PlayerId", "UserIdOwner", "Plr",
        "Occupied", "OccupiedBy", "InUse", "Locked", "ClaimedBy",
        "Creator", "User", "Account", "RunOwner", "HostPlayer"
    }
    local cur = inst
    local depth = 0
    while cur and cur ~= workspace and depth < 6 do
        for _, attr in ipairs(attrNames) do
            local ok, val = pcall(function() return cur:GetAttribute(attr) end)
            if ok and val ~= nil then
                local t = typeof(val)
                if t == "Instance" then
                    if val ~= player then return true end
                elseif t == "number" then
                    if val ~= 0 and val ~= player.UserId then return true end
                elseif t == "string" then
                    if val ~= "" and val:lower() ~= player.Name:lower() then return true end
                elseif t == "boolean" then
                    if val == true then return true end
                end
            end
        end
        for _, child in ipairs(cur:GetChildren()) do
            if child:IsA("ObjectValue") and child.Value and child.Value ~= player then return true end
            if child:IsA("StringValue") and child.Value ~= "" and child.Value:lower() ~= player.Name:lower() then return true end
            if child:IsA("IntValue") and child.Value ~= 0 and child.Value ~= player.UserId then return true end
        end
        cur = cur.Parent
        depth = depth + 1
    end
    return false
end

local function isOurClimbRun()
    local cr = workspace:FindFirstChild("ClimbRuns")
    if not cr then return false end
    local attrNames = {"Owner", "Player", "UserId", "PlayerId", "Plr", "RunOwner", "HostPlayer"}
    for _, attr in ipairs(attrNames) do
        local ok, val = pcall(function() return cr:GetAttribute(attr) end)
        if ok and val ~= nil then
            local t = typeof(val)
            if t == "Instance" and val ~= player then return false end
            if t == "number" and val ~= 0 and val ~= player.UserId then return false end
            if t == "string" and val ~= "" and val:lower() ~= player.Name:lower() then return false end
        end
    end
    for _, child in ipairs(cr:GetChildren()) do
        if child:IsA("ObjectValue") and child.Value and child.Value ~= player then return false end
        if child:IsA("IntValue") and child.Value ~= 0 and child.Value ~= player.UserId then return false end
        if child:IsA("StringValue") and child.Value ~= "" and child.Value:lower() ~= player.Name:lower() then return false end
    end
    return true
end

local function isSlime(mob)
    if not mob then return false end
    local lname = mob.Name:lower()
    if string.find(lname, "slime", 1, true) then return true end
    local parent = mob.Parent
    if parent then
        local lp = parent.Name:lower()
        if string.find(lp, "slime", 1, true) then return true end
        local gp = parent.Parent
        if gp then
            local lgp = gp.Name:lower()
            if string.find(lgp, "slime", 1, true) then return true end
        end
    end
    return false
end

local function isMobYours(mobHrp, root)
    if not mobHrp or not mobHrp.Parent then return false end
    if isMobDead(mobHrp.Parent) then return false end
    local hum = mobHrp.Parent:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then
        deadMobs[mobHrp.Parent] = true
        return false
    end
    if isSlime(mobHrp.Parent) then return false end
    if belongsToOtherPlayer(mobHrp.Parent) then return false end
    if root then
        local d = (mobHrp.Position - root.Position).Magnitude
        if d > config.MobMaxDistance then return false end
    end
    return true
end

