local function getRoot()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function teleportTo(position, offset)
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    offset = offset or Vector3.zero
    local target = CFrame.new(position + offset)

    pcall(function() root.Velocity = Vector3.zero end)
    pcall(function() root.AssemblyLinearVelocity = Vector3.zero end)
    pcall(function() root.RotVelocity = Vector3.zero end)
    pcall(function() root.AssemblyAngularVelocity = Vector3.zero end)

    local pivotOk = pcall(function() char:PivotTo(target) end)
    if not pivotOk then
        root.CFrame = target
    else
        task.wait()
        if (root.Position - (position + offset)).Magnitude > 10 then
            root.CFrame = target
        end
    end
    task.wait(0.05)
end

local function dropOnto(position, fallHeight, waitAfterLanding)
    fallHeight = fallHeight or config.PromptDropHeight
    waitAfterLanding = waitAfterLanding or config.TeleportSettleDelay

    local char = player.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local target = CFrame.new(position + Vector3.new(0, fallHeight, 0))

    pcall(function() root.Velocity = Vector3.zero end)
    pcall(function() root.AssemblyLinearVelocity = Vector3.zero end)
    pcall(function() root.RotVelocity = Vector3.zero end)
    pcall(function() root.AssemblyAngularVelocity = Vector3.zero end)

    pcall(function() char:PivotTo(target) end)
    root.CFrame = target

    task.wait()

    local start = tick()
    local lastY = root.Position.Y
    local stableSince = nil
    while tick() - start < 1.5 do
        task.wait(0.03)
        local y = root.Position.Y
        if math.abs(y - lastY) < 0.05 then
            if not stableSince then stableSince = tick() end
            if tick() - stableSince > 0.05 then break end
        else
            stableSince = nil
        end
        lastY = y
    end

    task.wait(waitAfterLanding)
    return true
end

local function safeDestroy(part)
    if part and part.Parent then
        pcall(function() part:Destroy() end)
    end
end

local function findByNamePrefix(root, prefix)
    local results = {}
    if not root then return results end
    for _, desc in ipairs(root:GetDescendants()) do
        if desc.Name:sub(1, #prefix) == prefix then table.insert(results, desc) end
    end
    return results
end

local function parseKeywords(str)
    local list = {}
    if not str or str == "" then return list end
    for piece in string.gmatch(str, "([^,]+)") do
        local trimmed = piece:match("^%s*(.-)%s*$")
        if trimmed ~= "" then table.insert(list, trimmed:lower()) end
    end
    return list
end

local function firePromptNoCD(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false end
    if not prompt.Enabled then return false end
    local ok1 = pcall(function()
        ProximityPromptService:InputHoldBegin(prompt, player)
        task.wait(math.max(prompt.HoldDuration or 0.05, 0.05))
        ProximityPromptService:InputHoldEnd(prompt, player)
    end)
    if ok1 then return true end
    local ok2 = pcall(function()
        if fireproximityprompt then fireproximityprompt(prompt) end
    end)
    if ok2 and fireproximityprompt then return true end
    return false
end

local function firePrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false end
    if not prompt.Enabled then return false end
    local last = state.firedPrompts[prompt]
    if last and (tick() - last) < state.firedCD then return false end
    state.firedPrompts[prompt] = tick()
    return firePromptNoCD(prompt)
end

local function isPlayerInside(part, padding)
    if not part or not part.Parent then return false end
    local root = getRoot()
    if not root then return false end
    local rel = part.CFrame:PointToObjectSpace(root.Position)
    local half = part.Size / 2
    padding = padding or 0
    return math.abs(rel.X) <= half.X + padding
       and math.abs(rel.Y) <= half.Y + padding
       and math.abs(rel.Z) <= half.Z + padding
end

