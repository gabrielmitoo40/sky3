local function fireAllPromptsIn(target)
    if not target then return false end

    local pos = nil
    if target:IsA("BasePart") then
        pos = target.Position
    elseif target:IsA("Model") then
        local p = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart", true)
        if p then pos = p.Position end
    elseif target:IsA("ProximityPrompt") then
        if target.Parent and target.Parent:IsA("BasePart") then
            pos = target.Parent.Position
        end
    end

    if pos then
        dropOnto(pos, config.PromptDropHeight, config.TeleportSettleDelay)
    end

    local fired = false
    local prompts = {}
    if target:IsA("ProximityPrompt") then table.insert(prompts, target) end
    if target:IsA("ClickDetector") then table.insert(prompts, target) end
    for _, d in ipairs(target:GetDescendants()) do
        if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then
            table.insert(prompts, d)
        end
    end

    if #prompts == 0 and pos then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then
                local part = d.Parent
                if part and part:IsA("BasePart") then
                    if (part.Position - pos).Magnitude <= 15 then
                        table.insert(prompts, d)
                    end
                end
            end
        end
    end

    for _, p in ipairs(prompts) do
        if p:IsA("ProximityPrompt") then
            if firePromptNoCD(p) then fired = true end
        elseif p:IsA("ClickDetector") then
            pcall(function() fireclickdetector(p) end)
            fired = true
        end
    end

    if not fired then
        task.wait(config.TeleportSettleDelay * 2)
        for _, p in ipairs(prompts) do
            if p:IsA("ProximityPrompt") then
                if firePromptNoCD(p) then fired = true end
            elseif p:IsA("ClickDetector") then
                pcall(function() fireclickdetector(p) end)
                fired = true
            end
        end
    end

    return fired
end

local function handleAutoReplay()
    if not config.AutoReplay then
        state.chestCollected = false
        state.chestCollectedAt = nil
        state.chestFiredCount = 0
        state.lastProgressAt = tick()
        return
    end
    if not isOurClimbRun() then
        state.chestCollected = false
        state.chestCollectedAt = nil
        state.chestFiredCount = 0
        state.lastProgressAt = tick()
        return
    end

    local cr = workspace:FindFirstChild("ClimbRuns")
    if not cr then
        state.chestCollected = false
        state.chestCollectedAt = nil
        state.chestFiredCount = 0
        state.lastProgressAt = tick()
        return
    end

    if tick() - state.runResetAt < config.RunResetCooldown then
        state.chestCollected = false
        state.chestCollectedAt = nil
        state.chestFiredCount = 0
        state.lastProgressAt = tick()
        return
    end

    if isBossAlive() then state.hasSeenBossAlive = true end

    if not state.hasSeenBossAlive or isBossAlive() then
        state.chestCollected = false
        state.chestCollectedAt = nil
        state.chestFiredCount = 0
        state.lastProgressAt = tick()
        return
    end

    local replayDoor = findReplayDoor()
    local chest = findRewardChest()

    local minDelay = math.max(config.ChestToReplayDelay or 2, 1)
    local minFires = math.max(config.MinChestFires or 5, 3)

    if state.chestCollected and (tick() - (state.lastProgressAt or tick())) > config.ChestStuckTimeout then
        state.chestCollected = false
        state.chestCollectedAt = nil
        state.chestFiredCount = 0
        state.lastProgressAt = tick()
        return
    end

    if not state.chestCollected then
        if chest then
            fireAllPromptsIn(chest)
            state.chestFiredCount = 1
        end
        state.chestCollected = true
        state.chestCollectedAt = tick()
        state.lastProgressAt = tick()
        return
    end

    local elapsed = tick() - (state.chestCollectedAt or 0)

    if elapsed < minDelay or state.chestFiredCount < minFires then
        if chest then
            fireAllPromptsIn(chest)
            state.chestFiredCount = state.chestFiredCount + 1
            state.lastProgressAt = tick()
        end
        return
    end

    if replayDoor then
        fireAllPromptsIn(replayDoor)
    end

    state.chestCollected = false
    state.chestCollectedAt = nil
    state.chestFiredCount = 0
    state.lastProgressAt = tick()
    state.hasSeenBossAlive = false
    state.runResetAt = tick()

    deadMobs = {}
end

