local function getTowerCircle()
    local cur = workspace
    for _, segment in ipairs(config.CirclePath) do
        if not cur then return nil end
        cur = cur:FindFirstChild(segment)
    end
    return cur
end

local function moveCircleToPlayer(circle)
    if not circle then return false end
    local root = getRoot()
    if not root then return false end
    local targetCFrame = CFrame.new(root.Position + Vector3.new(0, -3, 0))
    if circle:IsA("BasePart") then
        return pcall(function()
            circle.Anchored = true
            circle.CFrame = targetCFrame
        end)
    elseif circle:IsA("Model") then
        return pcall(function()
            for _, d in ipairs(circle:GetDescendants()) do
                if d:IsA("BasePart") then d.Anchored = true end
            end
            circle:PivotTo(targetCFrame)
        end)
    end
    return false
end

local function triggerNewTower()
    if tick() - state.lastNewTowerAt < config.NewTowerCooldown then return false end
    local circle = getTowerCircle()
    if not circle then return false end
    if not moveCircleToPlayer(circle) then return false end
    task.wait(0.4)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then return false end
    local remoteName = config.RemoteName or "ClimbStart"
    local remote = remotes:FindFirstChild(remoteName)
    if not remote then return false end
    local ok = pcall(function() remote:InvokeServer(config.ClimbFloor, config.ClimbDifficulty) end)
    if ok then state.lastNewTowerAt = tick(); return true end
    return false
end

