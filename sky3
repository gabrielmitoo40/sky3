local function readColorFromPart(part)
    if not part or not part:IsA("BasePart") then return nil, nil end
    if config.BossColorProperty == "BrickColor" then
        local ok, bc = pcall(function() return part.BrickColor end)
        if ok and bc then return bc, "BrickColor" end
    elseif config.BossColorProperty == "Color3" then
        local ok, c = pcall(function() return part.Color end)
        if ok and c then return c, "Color3" end
    else
        local ok, c = pcall(function() return part.Color end)
        if ok and c then return c, "Color3" end
    end
    return nil, nil
end

local function getBossColor(boss)
    if not boss then return nil, nil, nil end

    if config.BossColorPartHint ~= "auto" and config.BossColorPartHint ~= "" then
        local p = boss:FindFirstChild(config.BossColorPartHint, true)
        if p and p:IsA("BasePart") then
            local c, prop = readColorFromPart(p)
            if c then return c, prop, p end
        end
    end

    local samples = {}
    local maxVolume = 0
    for _, p in ipairs(boss:GetDescendants()) do
        if p:IsA("BasePart") and p.Transparency < 0.85 then
            local vol = p.Size.X * p.Size.Y * p.Size.Z
            if vol > maxVolume then maxVolume = vol end
            local ok, c = pcall(function() return p.Color end)
            if ok and c then
                local r, g, b = c.R, c.G, c.B
                local mx = math.max(r, g, b)
                local mn = math.min(r, g, b)
                local isNeutral = (mx - mn) < 0.08
                table.insert(samples, { color = c, part = p, volume = vol, isNeutral = isNeutral })
            end
        end
    end

    if #samples == 0 then return nil, nil, nil end

    local minVolume = maxVolume * 0.15
    local filtered = {}
    for _, s in ipairs(samples) do
        if s.volume >= minVolume then table.insert(filtered, s) end
    end
    if #filtered == 0 then filtered = samples end

    local colorful = {}
    for _, s in ipairs(filtered) do
        if not s.isNeutral then table.insert(colorful, s) end
    end
    if #colorful > 0 then filtered = colorful end

    local groups = {}
    for _, s in ipairs(filtered) do
        local r = math.floor(s.color.R * 20 + 0.5) / 20
        local g = math.floor(s.color.G * 20 + 0.5) / 20
        local b = math.floor(s.color.B * 20 + 0.5) / 20
        local key = string.format("%.2f_%.2f_%.2f", r, g, b)
        if not groups[key] then
            groups[key] = { color = Color3.new(r, g, b), totalVol = 0, sample = s }
        end
        groups[key].totalVol = groups[key].totalVol + s.volume
    end

    local bestGroup = nil
    for _, g in pairs(groups) do
        if not bestGroup or g.totalVol > bestGroup.totalVol then
            bestGroup = g
        end
    end

    if bestGroup then
        return bestGroup.sample.color, "Color3", bestGroup.sample.part
    end
    return nil, nil, nil
end

local function getMobSizeMagnitude(mob)
    local hrp = mob:FindFirstChild("HumanoidRootPart")
    if not hrp then return 0 end
    local s = hrp.Size
    return (s.X*s.X + s.Y*s.Y + s.Z*s.Z) ^ 0.5
end

