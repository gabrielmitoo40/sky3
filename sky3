local function getBossRoom()
    local cr = workspace:FindFirstChild("ClimbRuns")
    if not cr then return nil end
    local bossRoom = cr:FindFirstChild(config.BossRoomName)
    if bossRoom then return bossRoom end
    for _, c in ipairs(cr:GetChildren()) do
        if c.Name:find("_boss") then return c end
    end
    return nil
end

local function isBossAlive()
    if not isOurClimbRun() then return false end
    local bossRoom = getBossRoom()
    if not bossRoom then return false end
    local mobsFolder = bossRoom:FindFirstChild("Mobs")
    if not mobsFolder then return false end
    for _, mob in ipairs(mobsFolder:GetDescendants()) do
        if mob:IsA("Model") and mob:FindFirstChildOfClass("Humanoid") then
            trackMobDeath(mob)
            if not isMobDead(mob) and not isSlime(mob) then
                local hum = mob:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then return true end
            end
        end
    end
    return false
end

local function handleBoss()
    if not config.AutoBoss then
        state.bossEngaged = false
        state.lastTargetCount = 0
        return
    end
    if not isOurClimbRun() then
        state.bossEngaged = false
        state.lastTargetCount = 0
        return
    end
    local bossRoom = getBossRoom()
    if not bossRoom then
        state.bossEngaged = false
        state.lastTargetCount = 0
        state.debugColorString = "no boss room"
        return
    end
    if belongsToOtherPlayer(bossRoom) then
        state.bossEngaged = false
        state.lastTargetCount = 0
        return
    end

    local mobsFolder = bossRoom:FindFirstChild("Mobs")
    if not mobsFolder then
        state.bossEngaged = false
        state.lastTargetCount = 0
        return
    end
    local shepherd = mobsFolder:FindFirstChild("Mob_tower_flock_shepherd")
    if not shepherd then
        state.bossState = "idle"
        state.bossColor = nil
        state.bossColorProp = nil
        state.bossShepherdRef = nil
        state.bossEngaged = false
        state.lastTargetCount = 0
        state.debugColorString = "no shepherd"
        return
    end
    if isSlime(shepherd) then
        state.bossEngaged = false
        state.lastTargetCount = 0
        return
    end

    trackMobDeath(shepherd)

    if state.bossShepherdRef ~= shepherd then
        state.bossState = "idle"
        state.bossColor = nil
        state.bossColorProp = nil
        state.bossSize = nil
        state.bossName = nil
        state.bossPart = nil
        state.bossFirstSeenAt = nil
        state.bossShepherdRef = shepherd
        state.debugColorString = "new boss detected"
    end

    local hrp = shepherd:FindFirstChild("HumanoidRootPart")

    if state.bossState == "idle" then
        state.bossState = "seen"
        state.bossFirstSeenAt = tick()
    end
    if state.bossState == "seen" then
        if tick() - (state.bossFirstSeenAt or 0) >= config.BossColorReadDelay then
            local c, prop, partUsed = getBossColor(shepherd)
            state.bossColor = c
            state.bossColorProp = prop
            state.bossSize = getMobSizeMagnitude(shepherd)
            state.bossName = shepherd.Name
            state.bossState = "colored"
            state.bossPart = hrp
            if c and prop == "Color3" then
                local r = math.floor(c.R * 255)
                local g = math.floor(c.G * 255)
                local b = math.floor(c.B * 255)
                state.debugColorString = string.format("Color3 %d,%d,%d (part: %s)", r, g, b, partUsed and partUsed.Name or "?")
            elseif c and prop == "BrickColor" then
                state.debugColorString = string.format("BrickColor %s (part: %s)", tostring(c), partUsed and partUsed.Name or "?")
            else
                state.debugColorString = "no color read"
            end
        end
    end

    local living = {}
    for _, mob in ipairs(mobsFolder:GetDescendants()) do
        if mob:IsA("Model") and mob:FindFirstChildOfClass("Humanoid") and mob:FindFirstChild("HumanoidRootPart") then
            trackMobDeath(mob)
            if not isMobDead(mob) and not isSlime(mob) then
                if config.SheepNameFilter == "" or string.find(mob.Name:lower(), config.SheepNameFilter:lower(), 1, true) then
                    local mHum = mob:FindFirstChildOfClass("Humanoid")
                    if mHum and mHum.Health > 0 then
                        if not belongsToOtherPlayer(mob) then
                            table.insert(living, mob)
                        end
                    end
                end
            end
        end
    end

    state.lastTargetCount = #living

    if #living >= 2 then
        state.bossEngaged = true
        if tick() - state.lastBossHop >= config.MobPlatformInterval then
            state.lastBossHop = tick()
            local pick = living[math.random(1, #living)]
            local pickHrp = pick:FindFirstChild("HumanoidRootPart")
            if pickHrp then
                if config.AutoSwing and not state.autoWeaponPaused then
                    fireWeaponOnce()
                end
                teleportTo(pickHrp.Position, Vector3.new(0, 30, 0))
            end
        end
    else
        if hrp and hrp.Parent and not isMobDead(shepherd) then
            state.bossEngaged = true
            teleportTo(hrp.Position, config.BossTeleportOffset)
            local hum = hrp.Parent:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then
                state.bossState = "dead"
                state.bossDiedTime = tick()
                state.bossEngaged = false
            end
        else
            state.bossEngaged = false
        end
    end

    if state.bossState == "dead" and state.bossDiedTime and (tick() - state.bossDiedTime) >= 4 then
        state.bossState = "idle"
        state.bossDiedTime = nil
        state.bossColor = nil
        state.bossColorProp = nil
        state.bossPart = nil
        state.bossSize = nil
        state.bossName = nil
        state.bossFirstSeenAt = nil
        state.bossShepherdRef = nil
        state.bossEngaged = false
        state.lastTargetCount = 0
        state.debugColorString = "idle"
    end
end

