            local selected = i == index
            item.button.BackgroundColor3 = selected and UI.accentSoft or UI.panel
            item.icon.TextColor3 = selected and UI.text or UI.muted
            item.label.TextColor3 = selected and UI.text or UI.muted
        end
        searchBox.Text = ""
        applySearch("")
    end

