local function handleLoot()
    if not config.AutoLoot then return end
    if not isOurClimbRun() then return end
    local cr = workspace:FindFirstChild("ClimbRuns")
    if not cr then return end
    for _, obj in ipairs(findByNamePrefix(cr, "Loot_")) do
        if not belongsToOtherPlayer(obj) then
            local prompts = {}
            if obj:IsA("ProximityPrompt") then table.insert(prompts, obj) end
            for _, d in ipairs(obj:GetDescendants()) do
                if d:IsA("ProximityPrompt") then table.insert(prompts, d) end
            end
            if #prompts > 0 then
                local anchorPos = nil
                if obj:IsA("BasePart") then anchorPos = obj.Position end
                if not anchorPos and prompts[1].Parent and prompts[1].Parent:IsA("BasePart") then
                    anchorPos = prompts[1].Parent.Position
                end
                if anchorPos then dropOnto(anchorPos, config.PromptDropHeight, config.TeleportSettleDelay) end
                for _, p in ipairs(prompts) do firePromptNoCD(p) end
            end
            for _, cd in ipairs(obj:GetDescendants()) do
                if cd:IsA("ClickDetector") then pcall(function() fireclickdetector(cd) end) end
            end
        end
    end
end

-- ============================================================
-- AUTO BLESSING
-- ============================================================
local function handleBlessings()
    if not config.AutoBlessing then return end
    if not isOurClimbRun() then return end
    local cr = workspace:FindFirstChild("ClimbRuns")
    if not cr then return end
    local blessingFolders = findByNamePrefix(cr, "Blessings_")
    if #blessingFolders == 0 then return end

    local specificKeywords = {}
    if config.SpecificBlessing and config.BlessingName ~= "" then
        specificKeywords = parseKeywords(config.BlessingName)
    end

    for _, bf in ipairs(blessingFolders) do
        if not belongsToOtherPlayer(bf) then
            local blessings = {}
            for _, c in ipairs(bf:GetChildren()) do
                if c.Name:sub(1, 9) == "Blessing_" then table.insert(blessings, c) end
            end
            if #blessings == 0 then
                for _, d in ipairs(bf:GetDescendants()) do
                    if d.Name:sub(1, 9) == "Blessing_" then table.insert(blessings, d) end
                end
            end

            if #blessings > 0 then
                local target
                if #specificKeywords > 0 then
                    for _, b in ipairs(blessings) do
                        local lname = b.Name:lower()
                        for _, keyword in ipairs(specificKeywords) do
                            if string.find(lname, keyword, 1, true) then target = b; break end
                        end
                        if target then break end
                    end
                end
                if not target then target = blessings[math.random(1, #blessings)] end

                local prompts = {}
                if target:IsA("ProximityPrompt") then table.insert(prompts, target) end
                for _, d in ipairs(target:GetDescendants()) do
                    if d:IsA("ProximityPrompt") then table.insert(prompts, d) end
                end
                if #prompts > 0 then
                    local anchorPos = nil
                    if target:IsA("BasePart") then anchorPos = target.Position end
                    if not anchorPos and prompts[1].Parent and prompts[1].Parent:IsA("BasePart") then
                        anchorPos = prompts[1].Parent.Position
                    end
                    if anchorPos then dropOnto(anchorPos, config.PromptDropHeight, config.TeleportSettleDelay) end
                    for _, p in ipairs(prompts) do firePromptNoCD(p) end
                end
            end
        end
    end
end

